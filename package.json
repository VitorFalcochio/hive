{
  "name": "hive",
  "version": "0.1.0",
  "private": true,
  "description": "Hive — your AI development team. A desktop workspace for coordinating multiple coding agents.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "setup": "node scripts/run.mjs install --frozen-lockfile",
    "dev": "node scripts/run.mjs --filter @hive/desktop dev",
    "build": "node scripts/run.mjs --filter @hive/desktop build",
    "start": "node scripts/run.mjs --filter @hive/desktop start",
    "typecheck": "node scripts/run.mjs -r typecheck",
    "lint": "node scripts/run.mjs exec eslint . --max-warnings 0",
    "format": "node scripts/run.mjs exec prettier --write .",
    "format:check": "node scripts/run.mjs exec prettier --check .",
    "test": "node scripts/run.mjs exec vitest run",
    "test:watch": "node scripts/run.mjs exec vitest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
